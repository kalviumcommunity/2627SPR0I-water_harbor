# Campus WaterPoint Board - Environment Configuration
# Sprint: 2627SPR0I | Campus: CHR | Squad: 62 | Team: 03

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/waterpoint_db

# Individual DB parameters (fallback if DATABASE_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=waterpoint_db

# Security & Staff Authentication (reserved for future sprint features)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000


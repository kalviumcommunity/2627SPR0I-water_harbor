# Campus WaterPoint Board - Environment Configuration
# Sprint: 2627SPR0I | Campus: CHR | Squad: 62 | Team: 03

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/waterpoint_db

# Dedicated Test Database URL (mandatory for backend testing; must be separate from DATABASE_URL)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/waterpoint_test_db

# Individual DB parameters (fallback if DATABASE_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=waterpoint_db

# Application Environment (development | test | production)
ENVIRONMENT=development

# Security & Staff Session Configuration
# Required in production (minimum 32 characters; no ephemeral/legacy fallback).
# In local development, an ephemeral secret is generated per process if omitted.
SESSION_SECRET_KEY=
JWT_ALGORITHM=HS256
STAFF_SESSION_EXPIRE_MINUTES=60
SESSION_COOKIE_SAMESITE=lax
# Automatically forced to true in production; leave empty in local HTTP development
SESSION_COOKIE_SECURE=

# Anonymous Report Rate Limiting (POST /api/reports)
REPORT_RATE_LIMIT_ENABLED=true
REPORT_RATE_LIMIT_MAX_REQUESTS=5
REPORT_RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_IPS=[]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
